# =========================================================================
# VANVI MOMENTS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your production credentials.
# NEVER commit the real .env file with secrets into version control.
# =========================================================================

# --- 1. CORE APPLICATION ---
PORT=3000
NODE_ENV=production
BASE_URL=https://vanvimoments.shop
# Use a 64+ char random hex string in production: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
ADMIN_SECRET_KEY=replace_with_a_different_long_random_admin_secret
# Comma-separated list of allowed origins or *
ALLOWED_ORIGINS=https://vanvimoments.shop,https://www.vanvimoments.shop

# --- 1a. GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# --- 2. PRODUCTION DATABASE (PostgreSQL / Supabase / Neon / AWS RDS) ---
# Direct or pooled PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres?sslmode=require
# Or Supabase alias:
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres

# --- 3. PAYMENT GATEWAYS (Razorpay & Cashfree) ---
# Razorpay Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Cashfree Credentials (https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# --- 4. CLOUD MEDIA STORAGE (Cloudinary / AWS S3) ---
# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=vanvimoments
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Or Cloudinary URL format:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# AWS S3 / Cloudflare R2 alternative:
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- 5. ARTIFICIAL INTELLIGENCE PROVIDERS ---
# Google Gemini API Key (For Customer AI Assistant & Template Studio: https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI GPT API Key (Dedicated for Admin Autonomous Copilot: https://platform.openai.com)
ADMIN_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# --- 6. TRANSACTIONAL EMAIL & NOTIFICATIONS ---
# Standard SMTP (SendGrid, Amazon SES, Mailgun, Brevo, Gmail App Password)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Vanvi Moments <celebrate@vanvimoments.shop>

# Or Resend API (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- 7. MONITORING & OBSERVABILITY ---
# Sentry Error Monitoring DSN (https://sentry.io)
SENTRY_DSN=
